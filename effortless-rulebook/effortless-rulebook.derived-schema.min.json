{"Axes":[{"name":"AxisId","type":"raw"},{"name":"Name","type":"calculated","formula":"={{AxisId}}"},{"name":"Title","type":"raw"},{"name":"Summary","type":"raw"},{"name":"Scenarios","type":"calculated"},{"name":"Considerations","type":"calculated"},{"name":"CountOfConsiderations","type":"calculated","formula":"=COUNTIFS(Considerations!{{Axis}}, Axes!{{AxisId}})"},{"name":"CountOfPros","type":"calculated","formula":"=COUNTIFS(Considerations!{{Axis}}, Axes!{{AxisId}}, Considerations!{{IsPro}}, TRUE())"},{"name":"CountOfCons","type":"calculated","formula":"=COUNTIFS(Considerations!{{Axis}}, Axes!{{AxisId}}, Considerations!{{IsPro}}, FALSE())"}],"Scenarios":[{"name":"ScenarioId","type":"raw"},{"name":"Name","type":"calculated","formula":"={{ScenarioId}}"},{"name":"Axis","type":"calculated"},{"name":"AxisTitle","type":"calculated","formula":"=INDEX(Axes!{{Title}}, MATCH({{Axis}}, Axes!{{AxisId}}, 0))"},{"name":"Title","type":"raw"},{"name":"Description","type":"raw"}],"Considerations":[{"name":"ConsiderationId","type":"raw"},{"name":"Name","type":"calculated","formula":"={{ConsiderationId}}"},{"name":"Axis","type":"calculated"},{"name":"AxisTitle","type":"calculated","formula":"=INDEX(Axes!{{Title}}, MATCH({{Axis}}, Axes!{{AxisId}}, 0))"},{"name":"IsPro","type":"raw"},{"name":"Statement","type":"raw"},{"name":"Kind","type":"calculated","formula":"=IF({{IsPro}}, \u0022Pro\u0022, \u0022Con\u0022)"}]}